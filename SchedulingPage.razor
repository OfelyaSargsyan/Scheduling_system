    private async Task LoadWorkSchedulesAsync()
  
    {
        try
        {
            var client = HttpClientFactory.CreateClient(Consts.HttpClientName);
            var response = await client.GetFromJsonAsync<List<WorkScheduleDto>>("/api/schedule/get-work-schedules");

            if (response != null)
            {
                DroppedItems.Clear();

                foreach (var schedule in response.Where(s => s.Date.Date == CurrentDate.Date || s.ShiftId == SelectedShift?.Id))
                {
                    var flight = Flights.FirstOrDefault(f =>
                        f.ProgrammedTime.Date == schedule.Date.Date &&
                        Math.Abs((f.ProgrammedTime.TimeOfDay - schedule.StartTime).TotalMinutes) < 1);

                    if (flight != null)
                    {
                        var timeSlot = schedule.StartTime.ToString(@"hh\:mm");
                        var airline = flight.FlightNumber;
                        var cellId = $"{airline}-{timeSlot}";

                        if (!DroppedItems.ContainsKey(cellId))
                            DroppedItems[cellId] = new List<string>();

                        var empIdStr = schedule.EmployeeId.ToString();

                        if (!DroppedItems[cellId].Contains(empIdStr))
                            DroppedItems[cellId].Add(empIdStr);
                    }
                }

                StateHasChanged(); 
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading schedules: {ex.Message}");
        }
    }

    private async Task LoadFlightsFromDatabaseAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient(Consts.HttpClientName);
            var response = await client.GetFromJsonAsync<List<Flight>>("/api/flights/get-flights");

            if (response != null)
            {
                Flights = response
                    .Where(f => !string.IsNullOrWhiteSpace(f.FlightNumber))
                    .Select(f => new Item
                        {
                            FlightNumber = f.FlightNumber,
                            ProgrammedTime = f.ProgrammedTime,
                            FlightStatus = f.FlightStatus,
                            AirlineData = new AirlineData
                            {
                                Name = f.AirlineName
                            }
                        })
                    .ToList();

                FlightStrings = Flights
                    .Select(f => f.FlightNumber)
                    .Distinct()
                    .ToList();

                Console.WriteLine($"Flights fetched from DB: {Flights.Count}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading flights from DB: {ex.Message}");
        }
    }

   

    private async Task GenerateSchedule()
    {
        var client = HttpClientFactory.CreateClient(Consts.HttpClientName);
        var utcDate = DateTime.SpecifyKind(CurrentDate.Date, DateTimeKind.Utc);

        if (SelectedShift == null || string.IsNullOrWhiteSpace(SelectedShiftName))
        {
            ShowToast(new Notify
                {
                    Message = "⚠️ Please select a shift.",
                    Id = 0
                });
            return;
        }

        var shiftEmployees = await client.GetFromJsonAsync<List<Employee>>(
            $"/futureShiftHistories/employees-by-shift?shiftId={SelectedShift.Id}&date={utcDate:yyyy-MM-ddTHH:mm:ssZ}");

        if (shiftEmployees == null || !shiftEmployees.Any())
        {
            ShowToast(new Notify
                {
                    Message = "⚠️ There are no employees available for this shift.",
                    Id = 0
                });
            return;
        }

       // var response = await client.PostAsync($"/api/schedule/generate?date={CurrentDate:yyyy-MM-dd}", null);
        var response = await client.PostAsync($"/api/schedule/generate?date={CurrentDate:yyyy-MM-dd}&shiftId={SelectedShift.Id}", null);


        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("✅ Schedule generated in backend.");

            await LoadWorkSchedulesAsync();

            StateHasChanged();

            ShowToast(new Notify
                {
                    Message = "✅ Schedule generated and displayed!",
                    Id = 0
                });
        }
        else
        {
            Console.WriteLine("❌ Schedule generation failed.");
            ShowToast(new Notify
                {
                    Message = "❌ Schedule generation failed.",
                    Id = 0
                });
        }
    }


    private void UpdateDroppedItems()
    {
        DroppedItems.Clear();
        foreach (var schedule in WorkSchedules)
        {
            var airline = Flights.FirstOrDefault(f => f.ProgrammedTime.Date == schedule.Date.Date)?.FlightNumber;
            if (!string.IsNullOrEmpty(airline))
            {
                var timeSlot = schedule.StartTime.ToString(@"hh\:mm");
                var cellId = $"{airline}-{timeSlot}";
                if (!DroppedItems.ContainsKey(cellId))
                {
                    DroppedItems[cellId] = new List<string>();
                }
                var employeeId = schedule.Id.ToString();
                if (!DroppedItems[cellId].Contains(employeeId))
                {
                    DroppedItems[cellId].Add(employeeId);
                }
            }
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await SignalRService.StartConnectionAsync();

        SignalRService.ToastCallback = ShowToast;
        await LoadShifts();
        if (Shifts.Any())
        {
            SelectedShift = Shifts.First();
            SelectedShiftName = SelectedShift.Name;
            UpdateTimeSlots();
        }
        await LoadProfessionsFromDatabase();
        await LoadEmployeesFromDatabase();
        await AddFlightsToDatabaseAsync();
        //await GenerateSchedule();
        await LoadFlightsFromDatabaseAsync();
        await LoadWorkSchedulesAsync();

    }

}